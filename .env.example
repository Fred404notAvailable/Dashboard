# ─── Google Sheets (FREE — no API key needed) ─────────────────────────────
# 1. Open your Google Sheet
# 2. Click Share → "Anyone with the link" → Viewer → Done
# 3. Copy the Sheet ID from the URL (the long string between /d/ and /edit)
# 4. Find the GID for each tab: click the tab → look at ?gid=XXXXXXXX in the URL

GOOGLE_SHEET_ID=1LA9OtAT84949JbJrWXRGY03sczWyNLsXULykvd1Eerk
GOOGLE_SHEET_GID_200=0
GOOGLE_SHEET_GID_250=1

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://pyros:pyros_dev_2026@localhost:5432/registrations

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-32-byte-secret
JWT_REFRESH_SECRET=change-me-to-another-random-32-byte-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Reports ───────────────────────────────────────────────────────────────
REPORT_TIMEZONE=Asia/Kolkata
REPORT_TITLE=FAC PYROS - Registration Report
REPORT_SUBTITLE=That's How We Rock It!
REGISTRATION_GOAL=500

# ─── Sync schedule (cron expression) ──────────────────────────────────────
SYNC_INTERVAL_CRON=0 * * * *

